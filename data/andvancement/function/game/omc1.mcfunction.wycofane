execute if score omc AC_time matches -59 run function andvancement:core/clearomc1-5
#execute if score omc AC_time matches 2061 run function andvancement:core/clearomc1-5

# check
    execute if entity @s[advancements={andvancement:real/omc1=true}] run return fail
    execute unless entity @s[tag=omcCompleted] run return fail
    execute if score @s ADV_omc1 matches 1.. run return fail
    execute if score @s ADV_omc2 matches 1.. run return fail
    execute if score @s ADV_omc3 matches 1.. run return fail
    execute if score @s ADV_omc4 matches 1.. run return fail
    execute if score @s ADV_omc5 matches 1.. run return fail
    

# give (if already has second achievment, mark OMC as completed)
    execute if entity @s[advancements={andvancement:real/omc2=true}] run advancement grant @s from andvancement:mark/omc
    execute unless entity @s[advancements={andvancement:real/omc2=true}] run advancement grant @s only andvancement:real/omc1
    
    function andvancement:core/handle {"mode":"omc1"}