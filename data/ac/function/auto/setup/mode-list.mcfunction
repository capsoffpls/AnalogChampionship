$scoreboard players set action AC_autoControl $(action)
$data modify storage ac:auto action set value $(action)
$scoreboard players set page AC_autoControl $(page)

execute if score action AC_autoControl matches 1 run tellraw @s [{"text":"[AUTO] ","bold":true,"color":"gold"},{"text":"Konfiguracja - Wybierz tryb do zagrania\n","color":"yellow","bold":false}]
$execute if score action AC_autoControl matches 2 run tellraw @s [{"text":"[AUTO] ","bold":true,"color":"gold"},{"text":"Konfiguracja - Wybierz tryb do głosowania graczy ($(page)/4)\n","color":"yellow","bold":false}]
$execute if score action AC_autoControl matches 3 run tellraw @s [{"text":"[AUTO] ","bold":true,"color":"gold"},{"text":"Konfiguracja - Wybierz tryb do głosowania publiczności ($(page)/4)\n","color":"yellow","bold":false}]
