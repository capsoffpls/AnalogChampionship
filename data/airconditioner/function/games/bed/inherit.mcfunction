execute at @a[scores={AC_killmessage=1}] unless score @s AC_bedIron matches 0 run summon item ~ ~ ~ {Item:{id:"minecraft:iron_ingot",count:1},Tags:["inherit-iron"]}
execute store result entity @e[type=item,limit=1,tag=inherit-iron] Item.count int 1 run scoreboard players get @s AC_bedIron
execute unless score @s AC_bedIron matches ..0 run execute if score lang AC_lang matches 0 run tellraw @a[scores={AC_killmessage=1}] [{"text":"[BED] ","bold":true,"color":"dark_green"},{"text":"+ ","color":"gray","bold":false},{"score":{"name":"@s","objective":"AC_bedIron"},"color":"white","bold":false},{"text":" Żelaza","color":"gray","bold":false}]
